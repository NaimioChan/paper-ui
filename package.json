{
  "name": "paper-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "纸感直角设计系统 — Vue 3 组件库",
  "files": [
    "dist"
  ],
  "main": "./dist/paper-ui.js",
  "module": "./dist/paper-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/paper-ui.js"
    },
    "./style.css": "./dist/paper-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.preview.config.ts",
    "build": "vite build && node scripts/copy-styles.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check:style": "node scripts/check-style.mjs",
    "test": "node scripts/check-style.mjs && vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "license": "MIT",
  "author": "Naimio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaimioChan/paper-ui.git"
  },
  "homepage": "https://github.com/NaimioChan/paper-ui",
  "bugs": {
    "url": "https://github.com/NaimioChan/paper-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
